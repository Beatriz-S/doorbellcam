# Timezone Configuration
# Find your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Frigate RTSP Password
# Change this to a secure password
FRIGATE_RTSP_PASSWORD=your_secure_password_here

# Pi Zero Camera IP Address
# Update this with your actual Pi Zero IP address
DOORBELL_CAMERA_IP=192.168.1.100

# MQTT Configuration (optional)
# Uncomment and set these if you want MQTT authentication
# MQTT_USER=frigate
# MQTT_PASSWORD=your_mqtt_password_here

# Node-RED Configuration (optional)
# NODERED_USERNAME=admin
# NODERED_PASSWORD=your_nodered_password

